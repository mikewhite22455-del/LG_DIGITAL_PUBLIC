# LG Digital Live Trading & Exchange API Credentials
# Configure real keys securely in the AI Studio Secrets panel (never commit .env).
# Note: AI Quant Copilot uses Firebase AI Logic (no GEMINI_API_KEY needed).

# Optional API Bearer token for https://lg-digital-private.onrender.com or https://lg-digital-owner.onrender.com
LG_LIVE_API_TOKEN=LG_LIVE_API_TOKEN_DEFAULT_VALUE

# Kraken Pro Spot REST API (optional direct exchange execution)
KRAKEN_API_KEY=KRAKEN_API_KEY_DEFAULT_VALUE
KRAKEN_API_SECRET=KRAKEN_API_SECRET_DEFAULT_VALUE

# Coinbase Advanced Trade API (optional direct exchange execution)
COINBASE_API_KEY=COINBASE_API_KEY_DEFAULT_VALUE
COINBASE_API_SECRET=COINBASE_API_SECRET_DEFAULT_VALUE

# KuCoin Spot REST API (optional direct exchange execution)
KUCOIN_API_KEY=KUCOIN_API_KEY_DEFAULT_VALUE
KUCOIN_API_SECRET=KUCOIN_API_SECRET_DEFAULT_VALUE
KUCOIN_API_PASSPHRASE=KUCOIN_API_PASSPHRASE_DEFAULT_VALUE

# Bitstamp Spot REST API (optional direct exchange execution)
BITSTAMP_API_KEY=BITSTAMP_API_KEY_DEFAULT_VALUE
BITSTAMP_API_SECRET=BITSTAMP_API_SECRET_DEFAULT_VALUE
